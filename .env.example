# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio may inject this at runtime from user secrets.
GEMINI_API_KEY=replace-me

# App URL used when generating absolute links.
APP_URL=https://your-domain.example

# Existing business contact destinations
CONTACT_EMAIL_RECIPIENT=info@starmaxsystems.com
BUSINESS_EMAIL_RECIPIENT=eldho@starmaxsystems.com

# MongoDB Atlas or local MongoDB connection
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=starmax

# Initial owner account and signing secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# ImageKit server-side keys. Keep the private key out of frontend variables.
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Google Workspace SMTP over STARTTLS (port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-a-Google-Workspace-app-password
SMTP_FROM=mailer@example.com
ENQUIRY_EMAIL_TO=info@starmaxsystems.com
# Optional recruitment inbox for CV applications (falls back to ENQUIRY_EMAIL_TO)
CAREERS_EMAIL_TO=info@starmaxsystems.com
